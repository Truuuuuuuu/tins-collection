# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Your Facebook Page username, as in https://m.me/<username>
VITE_FB_PAGE_USERNAME=tinscollection

# Footer → "Where to find us". All optional; anything left blank is hidden.
# Full link to your Facebook Page. Leave blank to use facebook.com/<VITE_FB_PAGE_USERNAME>.
VITE_FB_PAGE_URL=
# Physical store, written how you'd tell a customer. It links to Google Maps.
VITE_STORE_ADDRESS=
# Exact map pin for "Get directions", as "latitude, longitude".
# Google Maps: long-press the shop, then tap the numbers to copy them.
VITE_STORE_COORDS=
